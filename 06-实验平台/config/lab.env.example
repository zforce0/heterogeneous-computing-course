# 互联异构计算实验 · 实验室参数模板
# ---------------------------------------------------------------------------
# 复制为 config/lab.env 后按实际环境修改：cp config/lab.env.example config/lab.env
# 本文件只含地址/别名，不含任何口令；lab.env 已被 .gitignore 排除。
# 不创建 lab.env 时，程序回退到本模板中的“课程默认示例值”（即原实验网设置），
# 因此原有机器无需任何改动即可继续运行。
#
# 注意：这里填的是「实验室内部地址」，不是公网地址。换一台电脑部署时，
# 若仍使用 192.168.77.0/24 星型网络并保留相同 IP，则无需修改。

# —— 四节点实验网地址 ——
MAC_IP=192.168.77.1
ASCEND_IP=192.168.77.10
RK_IP=192.168.77.21
RV_IP=192.168.77.22

# —— 服务端监听 ——
DASH_HOST=127.0.0.1
DASH_PORT=8899
LLM_PORT=8080
RV_VISION_PORT=8082
RK_DASH_PORT=8081
RK_EVIDENCE_PORT=9100

# —— SSH 别名（在 ~/.ssh/config 里配置免密；不要把用户名/口令写进仓库）——
SSH_ASCEND=ascend
SSH_RK3588=rk3588
SSH_RV1126B=rv1126b

# —— 模型与运行时（仅用于文档/展示，实际以服务端 /props 与进程为准）——
LLM_MODEL_ALIAS=g4-edge-llm
VIS_MODEL=yolov8m_rv1126b.rknn
IR_MODEL=yolov8m_rv1126b.rknn
